---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PostList from '../components/PostList.astro';
import site from '../site.config';
import { postTypography } from '../lib/fonts';
import { attachmentsFor } from '../lib/files';
import Viewer from '../components/Viewer.astro';
import { getTree, allFolders, allPosts, findFolder, trail, formatDate, tagSlug } from '../lib/tree';

export async function getStaticPaths() {
  const tree = await getTree();
  return [
    ...allFolders(tree).map((f) => ({ params: { path: f.path }, props: { kind: 'folder', path: f.path } })),
    ...allPosts(tree).map((p) => ({ params: { path: p.path }, props: { kind: 'post', path: p.path } })),
  ];
}

const { kind, path } = Astro.props as { kind: 'folder' | 'post'; path: string };
const tree = await getTree();

const folder = kind === 'folder' ? findFolder(tree, path)! : undefined;
const post = kind === 'post' ? allPosts(tree).find((p) => p.path === path)! : undefined;
const crumbs = trail(tree, folder ? path.split('/').slice(0, -1).join('/') : post!.folderPath);

const files = post ? attachmentsFor(post) : [];
let Content: any, newer, older, toc: { depth: number; slug: string; text: string }[] = [];
if (post) {
  const rendered = await render(post.entry);
  Content = rendered.Content;
  toc = rendered.headings.filter((h) => h.depth === 2 || h.depth === 3);
  const siblings = findFolder(tree, post.folderPath)!.posts;
  const i = siblings.findIndex((p) => p.path === post.path);
  newer = siblings[i - 1];
  older = siblings[i + 1];
}
---
<Base
  title={folder ? folder.name : post!.data.title}
  description={folder ? folder.description : post!.data.description}
  current={path}
  wide={files.length > 0}
>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/">Home</a>
    {crumbs.map((c) => (<><span aria-hidden="true">/</span><a href={`/${c.path}/`}>{c.name}</a></>))}
  </nav>

  {folder && (
    <>
      <div class="folder-head">
        <Icon icon={folder.icon} size="2.1rem" />
        <h1>{folder.name}</h1>
      </div>
      {folder.description && <p class="lede">{folder.description}</p>}

      {folder.folders.length > 0 && (
        <>
          <h2 class="section-title">Folders inside</h2>
          <ul class="folders">
            {folder.folders.map((f) => (
              <li>
                <a href={`/${f.path}/`}>
                  <Icon icon={f.icon} />
                  <strong>{f.name}</strong>
                  <small>{f.description ?? `${f.count} ${f.count === 1 ? 'post' : 'posts'}`}</small>
                </a>
              </li>
            ))}
          </ul>
        </>
      )}

      {folder.posts.length > 0 && (
        <>
          <h2 class="section-title">Posts</h2>
          <PostList posts={folder.posts} />
        </>
      )}
    </>
  )}

  {post && (
    <article class={files.length ? "post with-files" : "post"} style={postTypography(post.folderPath, post.data)}>
      <div class="post-main">
        <h1>{post.data.icon && <Icon icon={post.data.icon} kind="file" size="0.9em" />} {post.data.title}</h1>
        <div class="post-meta">
          {post.data.date && <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>}
          {post.data.updated && <span>Updated {formatDate(post.data.updated)}</span>}
          <span>{post.minutes} min read</span>
          {post.data.focusMinutes && <span title="Time spent writing this with the focus tree">🌳 Written in {post.data.focusMinutes} focused min</span>}
          {post.data.draft && <span class="tag">Draft, only visible while you preview</span>}
          {post.data.tags.map((t) => <a class="tag" href={`/tags/${tagSlug(t)}/`}>{t}</a>)}
          {site.text.readerControls && (
            <span class="sizer" role="group" aria-label="Text size">
              <button type="button" data-size="-1" aria-label="Smaller text">A−</button>
              <button type="button" data-size="0" aria-label="Reset text size">A</button>
              <button type="button" data-size="1" aria-label="Larger text">A+</button>
            </span>
          )}
        </div>
        {toc.length >= 3 && (
          <details class="toc" open>
            <summary>On this page</summary>
            <ol>
              {toc.map((h) => <li class={h.depth === 3 ? 'sub' : undefined}><a href={`#${h.slug}`}>{h.text}</a></li>)}
            </ol>
          </details>
        )}
        <div class="prose">
          <Content />
        </div>
        {(newer || older) && (
          <nav class="pager" aria-label="More in this folder">
            {older && <a class="prev" href={`/${older.path}/`}><small>Older</small>{older.data.title}</a>}
            {newer && <a class="next" href={`/${newer.path}/`}><small>Newer</small>{newer.data.title}</a>}
          </nav>
        )}

        {files.length > 0 && (
          <section class="file-list">
            <h2>Files</h2>
            <ul>
              {files.map((f) => (
                <li>{f.url ? <a href={f.url} download={f.name}>{f.name}</a> : <span>{f.name} (missing)</span>}</li>
              ))}
            </ul>
          </section>
        )}
      </div>
      {files.length > 0 && <Viewer files={files} />}
    </article>
  )}
</Base>

<script>
  // Copy buttons on code blocks
  document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'copy-btn';
    btn.textContent = 'Copy';
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? pre.innerText);
        btn.textContent = 'Copied';
      } catch {
        btn.textContent = 'Select and copy';
      }
      btn.toggleAttribute('data-done', true);
      setTimeout(() => { btn.textContent = 'Copy'; btn.removeAttribute('data-done'); }, 1600);
    });
    pre.append(btn);
  });

  const root = document.documentElement;
  document.querySelectorAll<HTMLButtonElement>('.sizer button').forEach((btn) => {
    btn.addEventListener('click', () => {
      const current = parseFloat(getComputedStyle(root).getPropertyValue('--reader-scale')) || 1;
      const dir = Number(btn.dataset.size);
      const next = dir === 0 ? 1 : Math.min(1.6, Math.max(0.8, +(current + dir * 0.1).toFixed(2)));
      root.style.setProperty('--reader-scale', String(next));
      try { localStorage.setItem('reader-scale', String(next)); } catch {}
    });
  });
</script>
