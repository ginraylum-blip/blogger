---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getTree, allTags } from '../../lib/tree';

export async function getStaticPaths() {
  const tags = allTags(await getTree());
  return tags.map((t) => ({ params: { tag: t.slug }, props: { slug: t.slug } }));
}
const tree = await getTree();
const tag = allTags(tree).find((t) => t.slug === Astro.props.slug)!;
---
<Base title={`Tagged “${tag.name}”`} current="tags">
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">/</span><a href="/tags/">All tags</a>
  </nav>
  <h1>Tagged “{tag.name}”</h1>
  <PostList posts={tag.posts} tree={tree} />
</Base>
