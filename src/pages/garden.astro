---
import Base from '../layouts/Base.astro';
import GardenScene from '../components/GardenScene.astro';
import { treeSvg } from '../lib/focus-tree';
import { spriteSvg } from '../lib/sprites';
import { SPECIES, ANIMALS, KINDS, unlocked, unlockedAnimals, nextAnimal, goalText, leftText, totalMinutes, hoursText, type Session } from '../lib/garden';
import { siteProgress, animalColors } from '../lib/garden-data';
import garden from '../data/garden.json';
import site from '../site.config';

const sessions = garden.sessions as Session[];
const p = await siteProgress();
const colors = animalColors();
const minutes = totalMinutes(sessions);
const animals = unlockedAnimals(p);
const next = nextAnimal(p);
const isSample = sessions.length > 0 && sessions.every((s) => s.sample);
---
<Base title={site.garden.title} current="garden" description="Every tree here is a stretch of focused writing.">
  <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a></nav>
  <h1>{site.garden.title}</h1>
  <p class="lede">Every tree is a focused writing session. The animals moved in for posting, focusing, finishing sessions, writing lots of words and keeping streaks.</p>

  <dl class="g-stats">
    <div><dt>Focused writing</dt><dd>{hoursText(minutes)}</dd></div>
    <div><dt>Trees</dt><dd>{sessions.length}</dd></div>
    <div><dt>Words in posts</dt><dd>{p.words.toLocaleString('en-US')}</dd></div>
    <div><dt>Posts</dt><dd>{p.posts}</dd></div>
    <div><dt>Longest streak</dt><dd>{p.streak} day{p.streak === 1 ? '' : 's'}</dd></div>
    <div><dt>Animals</dt><dd>{animals.length} of {ANIMALS.length}</dd></div>
  </dl>

  {isSample && <p class="g-note">These are example trees. They’re replaced by your own the first time you save your garden from the Journal app.</p>}

  <div class="g-wide"><GardenScene sessions={sessions} animals={animals} colors={colors} /></div>

  <h2>Animals</h2>
  <p class="g-sub">{next ? `Closest to moving in: the ${next.name.toLowerCase()}, after ${leftText(next, p)}.` : 'Every animal has moved in. Impressive.'} Recolour yours in the Journal app (🌱 Focus, then tap an animal).</p>
  {KINDS.map((k) => (
    <>
      <h3 class="g-kind">{k.title}</h3>
      <p class="g-sub">{k.how}</p>
      <ul class="g-collection">
        {ANIMALS.filter((a) => a.kind === k.kind).map((a) => {
          const has = unlocked(a, p);
          return (
            <li class={has ? 'has' : 'locked'}>
              <span class="g-big" set:html={spriteSvg(a.sprite, 3, has ? a.name : 'A locked animal', has ? colors[a.sprite] : undefined)} />
              <strong>{has ? a.name : '???'}</strong>
              <small>{has ? goalText(a) : `at ${goalText(a)}`}</small>
            </li>
          );
        })}
      </ul>
    </>
  ))}

  <h2>Seeds</h2>
  <p class="g-sub">New seeds unlock as your total focus time grows.</p>
  <ul class="g-collection seeds">
    {SPECIES.map((s, i) => {
      const has = minutes >= s.hours * 60;
      return (
        <li class={has ? 'has' : 'locked'}>
          <span class="g-seed" data-pixel-tree={site.garden.pixelTrees ? '3' : undefined} set:html={treeSvg(1, 101 + i * 7, { species: s.id, label: s.name, inline: site.garden.pixelTrees })} />
          <strong>{s.name}</strong>
          <small>{has ? (s.hours ? `unlocked at ${s.hours} h` : 'from the start') : `at ${s.hours} hours`}</small>
        </li>
      );
    })}
  </ul>
</Base>

<style>
  .g-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr)); gap: 0.6rem; margin: 1.5rem 0; font-family: var(--font-ui); }
  .g-stats div { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 0.7rem 0.9rem; }
  .g-stats dt { font-size: 0.8rem; color: var(--muted); }
  .g-stats dd { margin: 0.1rem 0 0; font-size: 1.35rem; font-weight: 700; font-family: var(--font-heading); }
  .g-note { font-family: var(--font-ui); font-size: 0.9rem; background: var(--highlight); color: var(--ink); padding: 0.6rem 0.9rem; border-radius: var(--radius); }
  .g-wide { max-width: none !important; margin: 0 0 1rem; }
  .g-sub { color: var(--muted); font-family: var(--font-ui); font-size: 0.92rem; margin-top: -0.4rem; }
  .g-collection { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(6.5rem, 1fr)); gap: 0.6rem; font-family: var(--font-ui); }
  .g-collection li { display: flex; flex-direction: column; align-items: center; gap: 0.15rem; text-align: center; padding: 0.8rem 0.4rem; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line); }
  .g-collection small { color: var(--muted); font-size: 0.78rem; }
  .g-big { display: block; margin-bottom: 0.25rem; }
  .g-kind { margin: 1.4rem 0 0.5rem; font-size: 1.05rem; }
  .g-seed { width: 5rem; aspect-ratio: 180 / 156; display: block; }
  .g-seed :global(svg), .g-seed :global(img) { width: 100%; height: 100%; display: block; }
  .locked { opacity: 0.55; }
  .locked .g-big { filter: grayscale(1) brightness(0); opacity: 0.25; }
  .locked .g-seed { filter: grayscale(1); opacity: 0.45; }
</style>
