---
import { isImage } from '../lib/tree';
interface Props { icon?: string; kind?: 'folder' | 'file'; size?: string }
const { icon, kind = 'folder', size = '1.15em' } = Astro.props;
---
{icon ? (
  isImage(icon)
    ? <img class="icon" src={icon} alt="" width="20" height="20" style={`width:${size};height:${size}`} />
    : <span class="icon emoji" aria-hidden="true" style={`font-size:${size}`}>{icon}</span>
) : kind === 'folder' ? (
  <svg class="icon" viewBox="0 0 20 20" aria-hidden="true" style={`width:${size};height:${size}`}>
    <path d="M2.5 5.5a1.5 1.5 0 0 1 1.5-1.5h3.6l1.8 2H16a1.5 1.5 0 0 1 1.5 1.5v7A1.5 1.5 0 0 1 16 16H4a1.5 1.5 0 0 1-1.5-1.5z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
  </svg>
) : (
  <svg class="icon" viewBox="0 0 20 20" aria-hidden="true" style={`width:${size};height:${size}`}>
    <path d="M5 2.75h6.5L15 6.25v11H5z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
    <path d="M7.5 10h5M7.5 13h5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
  </svg>
)}
