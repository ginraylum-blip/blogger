---
import site from '../site.config';
import Sidebar from '../components/Sidebar.astro';
import { getTree, isImage } from '../lib/tree';
import { googleFontsHref } from '../lib/fonts';
import { themeCss, earlyScript } from '../lib/theme';
import '../styles/global.css';

interface Props { title?: string; description?: string; current?: string; wide?: boolean }
const { title, description, current = '', wide = false } = Astro.props;
const tree = await getTree();
const pageTitle = title ? `${title} · ${site.title}` : site.title;

const googleHref = googleFontsHref();
const themeStyles = themeCss();
const bg = site.background;

const favicon = isImage(site.favicon)
  ? site.favicon
  : `data:image/svg+xml,${encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><text y=".9em" font-size="90">${site.favicon}</text></svg>`)}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description || site.bio} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description || site.bio} />
    <link rel="icon" href={favicon} />
    {site.visibility === 'private' && <meta name="robots" content="noindex, nofollow" />}
    {googleHref && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href={googleHref} />
      </>
    )}
    <style is:inline set:html={themeStyles}></style>
    <script is:inline set:html={earlyScript}></script>
  </head>
  <body class={[bg.image && 'has-bg', wide && 'wide'].filter(Boolean).join(' ') || undefined}>
    <noscript><style>.search, .theme-btn, .sizer { display: none !important; }</style></noscript>
    <a class="skip" href="#main">Skip to content</a>
    <div class="shell">
      <Sidebar tree={tree} current={current} />
      <main id="main" class="page panel">
        <slot />
      </main>
    </div>
  </body>
</html>
