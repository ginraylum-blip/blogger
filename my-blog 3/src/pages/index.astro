---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PostList from '../components/PostList.astro';
import site from '../site.config';
import { getTree, allPosts } from '../lib/tree';
import GardenScene from '../components/GardenScene.astro';
import { unlockedAnimals, totalMinutes, hoursText, type Session } from '../lib/garden';
import { siteProgress, animalColors } from '../lib/garden-data';
import garden from '../data/garden.json';

const tree = await getTree();
const posts = allPosts(tree);
const pinned = posts.filter((p) => p.data.pinned);
const latest = posts.filter((p) => !p.data.pinned).slice(0, 8);
const sessions = garden.sessions as Session[];
const animals = unlockedAnimals(await siteProgress());
const colors = animalColors();
---
<Base current="">
  <section class="hero">
    <img src={site.profileImage} alt={`Photo of ${site.author}`} width="112" height="112" />
    <div>
      <h1>{site.author}</h1>
      <p>{site.bio}</p>
      {site.links.length > 0 && (
        <p class="links">
          {site.links.map((l) => (
            <a href={l.url} rel="me noopener"><Icon icon={l.icon} size="1em" />{l.label}</a>
          ))}
        </p>
      )}
    </div>
  </section>

  {pinned.length > 0 && (
    <>
      <h2 class="section-title">📌 Pinned</h2>
      <PostList posts={pinned} tree={tree} />
    </>
  )}

  {site.garden.showOnHome && (
    <section class="home-garden">
      <h2 class="section-title"><a href="/garden/">🌳 {site.garden.title}</a></h2>
      <p class="home-garden-stats">
        {sessions.length} tree{sessions.length === 1 ? '' : 's'} from {hoursText(totalMinutes(sessions))} of focused writing,
        and {animals.length} animal{animals.length === 1 ? '' : 's'} living there. <a href="/garden/">Visit the garden</a>
      </p>
      <a href="/garden/" class="home-garden-scene" aria-label="Visit the garden"><GardenScene sessions={sessions} animals={animals} colors={colors} limit={14} /></a>
    </section>
  )}

  <h2 class="section-title">Folders</h2>
  {tree.folders.length ? (
    <ul class="folders">
      {tree.folders.map((f) => (
        <li>
          <a href={`/${f.path}/`}>
            <Icon icon={f.icon} />
            <strong>{f.name}</strong>
            <small>{f.description ?? `${f.count} ${f.count === 1 ? 'post' : 'posts'}`}</small>
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <p class="empty">No folders yet. Make a folder inside src/content/posts/ and it shows up here.</p>
  )}

  <h2 class="section-title">Latest posts</h2>
  {latest.length ? <PostList posts={latest} tree={tree} /> : <p class="empty">No posts yet. Write one in Pages CMS, or run <code>npm run new</code>.</p>}
</Base>

<style>
  .home-garden .section-title a { color: inherit; text-decoration: none; }
  .home-garden-stats { font-family: var(--font-ui); font-size: 0.92rem; color: var(--muted); margin: -0.4rem 0 0.75rem; }
  .home-garden-scene { display: block; border-radius: var(--radius); }
  .home-garden-scene:hover { outline: 2px solid var(--accent); outline-offset: 2px; }
</style>
