---
import Base from '../../layouts/Base.astro';
import { getTree, allTags } from '../../lib/tree';
const tags = allTags(await getTree());
---
<Base title="All tags" current="tags">
  <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a></nav>
  <h1>All tags</h1>
  {tags.length ? (
    <ul class="tag-cloud">
      {tags.map((t) => <li><a class="tag" href={`/tags/${t.slug}/`}>{t.name}<small>{t.posts.length}</small></a></li>)}
    </ul>
  ) : (
    <p class="empty">No tags yet. Add <code>tags: [ideas, school]</code> to the top of a post and they show up here.</p>
  )}
</Base>
