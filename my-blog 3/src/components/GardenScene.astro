---
// Draws your garden: one tree per focus session, plus the animals you've unlocked.
import { type Session } from '../lib/garden';
import { gardenSceneHtml } from '../lib/garden-scene';
import { type AllColors } from '../lib/sprites';
import site from '../site.config';
import '../styles/trees.css';
import '../styles/garden.css';

interface Props {
  sessions: Session[];
  animals: readonly { sprite: string; name: string; flies?: boolean }[];
  colors?: AllColors;
  limit?: number; // show only the newest trees (for the home page)
}
const { sessions, animals, colors, limit } = Astro.props;
const scene = gardenSceneHtml({ sessions, animals, colors, limit, pixel: site.garden.pixelTrees });
---
<div class="garden-scene" style={`height:${scene.height}px`} role="img" aria-label={scene.label} set:html={scene.html} />

<script>
  import { pixelatePage } from '../lib/pixel';
  pixelatePage();
</script>
